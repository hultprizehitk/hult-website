{
  "name": "quiz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "node scripts/next-exfat.cjs build --webpack",
    "start": "node scripts/next-exfat.cjs start -p 3001",
    "lint": "eslint",
    "test": "firebase emulators:exec --only firestore,auth --project demo-hult-quiz \"vitest run\"",
    "test:watch": "vitest",
    "seed": "node --env-file=.env.local --import tsx scripts/seed-dev.ts",
    "sync-teams": "node --env-file=.env.local --import tsx scripts/sync-teams.ts",
    "simulate": "node --env-file=.env.local --import tsx scripts/simulate.ts",
    "test:unit": "vitest run tests/unit",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-hult-quiz"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.10.2",
    "motion": "^13.4.2",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "firebase-tools": "^15.31.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
