# Local-only demo project. Keep these values for emulator-based development.
GCLOUD_PROJECT=demo-hult-quiz
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hult-quiz
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true

# Dev login is available only with a non-production Next.js server.
QUIZ_DEV_LOGIN=true
AUTH_SECRET=replace-with-a-local-random-secret
AUTH_TRUST_HOST=true

# Optional: Google OAuth for local sign-in instead of the dev login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
