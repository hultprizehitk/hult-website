# Hult Prize HITK — Environment Variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Database URI (Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hult-website?retryWrites=true&w=majority

# Google OAuth 2.0 Credentials (Heritage Domain Restricted)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth Secrets & URLs
AUTH_SECRET=your-random-32-char-secret
NEXTAUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Super Admin Clearance (Comma-separated Heritage emails with master_admin privileges)
ADMIN_EMAILS=lead1@heritageit.edu.in,lead2@heritageit.edu.in